# Lueur — local and CI release lanes. No EAS, no Expo cloud service.
#
#   bundle exec fastlane android build     # signed AAB in build/android/
#   bundle exec fastlane android beta      # → Google Play internal testing
#   bundle exec fastlane android release   # → Google Play production (+ listing)
#   bundle exec fastlane android metadata  # listing and screenshots only
#   bundle exec fastlane ios build         # signed IPA in build/ios/ (macOS)
#   bundle exec fastlane ios beta          # → TestFlight
#   bundle exec fastlane ios release       # → App Store (+ listing, screenshots)
#
# Every credential is read from the environment; see docs/RELEASE.md.

default_platform(:android)

ROOT = File.expand_path('..', __dir__)
BUILD_DIR = File.join(ROOT, 'build')

def env!(name)
  value = ENV[name]
  UI.user_error!("Missing environment variable #{name} (see docs/RELEASE.md)") if value.nil? || value.empty?
  value
end

def flag?(name)
  %w[1 true yes].include?(ENV.fetch(name, '').downcase)
end

# The build number is baked in at `expo prebuild` through app.config.ts.
def prebuild(platform, build_number)
  ENV['LUEUR_BUILD_NUMBER'] = build_number.to_s
  UI.message("Build number #{build_number}")
  Dir.chdir(ROOT) do
    sh('npx', 'expo', 'prebuild', '--platform', platform, '--clean', *(platform == 'android' ? ['--no-install'] : []))
  end
end

platform :android do
  def play_key_options
    if ENV['PLAY_JSON_KEY']
      { json_key_data: ENV['PLAY_JSON_KEY'] }
    elsif ENV['PLAY_JSON_KEY_PATH']
      { json_key: ENV['PLAY_JSON_KEY_PATH'] }
    else
      {}
    end
  end

  def next_version_code
    return ENV['LUEUR_BUILD_NUMBER'].to_i if ENV['LUEUR_BUILD_NUMBER']
    return 1 if play_key_options.empty?

    codes = %w[internal alpha beta production].flat_map do |track|
      google_play_track_version_codes(track: track, **play_key_options)
    rescue StandardError
      []
    end
    (codes.max || 0) + 1
  end

  # Signing: LUEUR_UPLOAD_STORE_FILE, LUEUR_UPLOAD_STORE_PASSWORD, LUEUR_UPLOAD_KEY_ALIAS,
  # LUEUR_UPLOAD_KEY_PASSWORD (env or ~/.gradle/gradle.properties). Without them the AAB is
  # signed with the debug key: fine to test locally, rejected by Google Play.
  def signing_properties
    keys = %w[LUEUR_UPLOAD_STORE_FILE LUEUR_UPLOAD_STORE_PASSWORD LUEUR_UPLOAD_KEY_ALIAS LUEUR_UPLOAD_KEY_PASSWORD]
    return {} unless keys.all? { |k| ENV[k] }

    keys.to_h { |k| [k, k == 'LUEUR_UPLOAD_STORE_FILE' ? File.expand_path(ENV[k]) : ENV[k]] }
  end

  desc 'Prebuild and build a signed release AAB (build/android/lueur-<version>.aab)'
  lane :build do
    prebuild('android', next_version_code)
    gradle(
      project_dir: File.join(ROOT, 'android'),
      task: 'bundle',
      build_type: 'Release',
      properties: signing_properties,
      print_command: false,
    )
    aab = lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]
    FileUtils.mkdir_p(File.join(BUILD_DIR, 'android'))
    target = File.join(BUILD_DIR, 'android', "lueur-#{ENV['LUEUR_BUILD_NUMBER']}.aab")
    FileUtils.cp(aab, target)
    verify_no_internet_permission
    UI.success("AAB ready: #{target}")
    target
  end

  desc 'Fails if the merged release manifest still requests network access'
  private_lane :verify_no_internet_permission do
    manifest = Dir[File.join(ROOT, 'android/app/build/intermediates/merged_manifest/release/**/AndroidManifest.xml')].first
    UI.user_error!('Merged release manifest not found') unless manifest
    content = File.read(manifest)
    if content.include?('android.permission.INTERNET')
      UI.user_error!('INTERNET permission found in the release manifest')
    end
    UI.success('Release manifest has no INTERNET permission')
  end

  desc 'Build and upload to Google Play internal testing'
  lane :beta do
    aab = build
    upload_to_play_store(
      track: 'internal',
      aab: aab,
      release_status: flag?('LUEUR_PLAY_DRAFT') ? 'draft' : 'completed',
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      metadata_path: File.join(ROOT, 'fastlane/metadata/android'),
      **play_key_options,
    )
  end

  desc 'Build and upload to Google Play production with the store listing'
  lane :release do
    aab = build
    upload_to_play_store(
      track: 'production',
      aab: aab,
      release_status: flag?('LUEUR_PLAY_DRAFT') ? 'draft' : 'completed',
      metadata_path: File.join(ROOT, 'fastlane/metadata/android'),
      **play_key_options,
    )
  end

  desc 'Upload the Google Play listing (texts, images, screenshots) without a build'
  lane :metadata do
    upload_to_play_store(
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      metadata_path: File.join(ROOT, 'fastlane/metadata/android'),
      **play_key_options,
    )
  end
end

platform :ios do
  WORKSPACE = File.join(ROOT, 'ios/Lueur.xcworkspace')
  PROJECT = File.join(ROOT, 'ios/Lueur.xcodeproj')

  # App Store Connect API key: ASC_KEY_ID, ASC_ISSUER_ID and ASC_KEY_P8 (base64 of the .p8)
  # or ASC_KEY_PATH (path to the .p8).
  def asc_api_key
    options = { key_id: env!('ASC_KEY_ID'), issuer_id: env!('ASC_ISSUER_ID') }
    if ENV['ASC_KEY_P8']
      options.merge!(key_content: ENV['ASC_KEY_P8'], is_key_content_base64: true)
    else
      options[:key_filepath] = File.expand_path(env!('ASC_KEY_PATH'))
    end
    app_store_connect_api_key(**options)
  end

  def next_build_number(api_key)
    return ENV['LUEUR_BUILD_NUMBER'].to_i if ENV['LUEUR_BUILD_NUMBER']

    latest_testflight_build_number(api_key: api_key, app_identifier: 'app.lueur', initial_build_number: 0) + 1
  end

  # CI: imports the distribution certificate from IOS_DIST_CERT_P12 (base64) and
  # IOS_DIST_CERT_PASSWORD into a temporary keychain. Local Mac: fetches or creates it.
  def install_signing(api_key)
    if ENV['IOS_DIST_CERT_P12']
      setup_ci
      p12 = File.join(Dir.tmpdir, 'lueur-dist.p12')
      File.binwrite(p12, Base64.decode64(ENV['IOS_DIST_CERT_P12']))
      import_certificate(
        certificate_path: p12,
        certificate_password: env!('IOS_DIST_CERT_PASSWORD'),
        keychain_name: ENV['MATCH_KEYCHAIN_NAME'] || 'fastlane_tmp_keychain',
        keychain_password: ENV['MATCH_KEYCHAIN_PASSWORD'] || '',
      )
    else
      get_certificates(api_key: api_key)
    end
    get_provisioning_profile(api_key: api_key, app_identifier: 'app.lueur', provisioning_name: 'Lueur App Store')
  end

  desc 'Prebuild and build a signed App Store IPA (build/ios/Lueur.ipa)'
  lane :build do
    api_key = asc_api_key
    prebuild('ios', next_build_number(api_key))
    install_signing(api_key)
    update_code_signing_settings(
      path: PROJECT,
      use_automatic_signing: false,
      team_id: env!('APPLE_TEAM_ID'),
      targets: ['Lueur'],
      code_sign_identity: 'Apple Distribution',
      profile_name: lane_context[SharedValues::SIGH_NAME],
    )
    build_app(
      workspace: WORKSPACE,
      scheme: 'Lueur',
      configuration: 'Release',
      export_method: 'app-store',
      output_directory: File.join(BUILD_DIR, 'ios'),
      output_name: 'Lueur.ipa',
      clean: true,
    )
  end

  desc 'Build and upload to TestFlight'
  lane :beta do
    build
    upload_to_testflight(
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      skip_waiting_for_build_processing: true,
    )
  end

  desc 'Build and upload to the App Store with listing and screenshots (submit with LUEUR_SUBMIT=1)'
  lane :release do
    build
    upload_to_app_store(
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      metadata_path: File.join(ROOT, 'fastlane/metadata/ios'),
      screenshots_path: File.join(ROOT, 'fastlane/screenshots/ios'),
      overwrite_screenshots: true,
      submit_for_review: flag?('LUEUR_SUBMIT'),
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: { add_id_info_uses_idfa: false, export_compliance_uses_encryption: false },
    )
  end

  desc 'Upload App Store texts and screenshots without a build'
  lane :metadata do
    upload_to_app_store(
      api_key: asc_api_key,
      skip_binary_upload: true,
      metadata_path: File.join(ROOT, 'fastlane/metadata/ios'),
      screenshots_path: File.join(ROOT, 'fastlane/screenshots/ios'),
      overwrite_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false,
    )
  end
end
